{
  "name": "roamwise",
  "version": "1.0.0",
  "description": "RoamWise Pro — AI travel planner (Capacitor Multiplatform App)",
  "scripts": {
    "sync": "npm run android:prepare",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "test:trail-mesh": "node scripts/test-trail-mesh-access.mjs",
    "test:android-checkout-insets": "node scripts/test-android-checkout-insets.mjs",
    "test:google-auth-config": "node --test scripts/test-google-services-config.mjs",
    "web:refresh": "node scripts/sync-roamwise-web.cjs",
    "android:prepare": "npm run web:refresh && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-speech-recognition": "^8.4.6",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
