{
  "appId": "com.gyanverse.roamwise",
  "appName": "RoamWise",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Geolocation": {
      "permissions": [
        "location"
      ]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#07090F"
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#07090F",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    }
  }
}