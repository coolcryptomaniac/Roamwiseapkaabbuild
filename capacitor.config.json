{
  "appId": "com.gyanverse.roamwise",
  "appName": "RoamWise",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Geolocation": {
      "permissions": [
        "location"
      ]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#07090F"
    },
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#07090F",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}
